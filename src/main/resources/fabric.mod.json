{
	"schemaVersion": 1,
	"id": "copperrails",
	"version": "${version}",
	"name": "Modified Copper Rails",
	"description": "A modified version of the Copper Rails mod by Rob0fox.",
	"authors": [
		"Assassinreport & Rob0fox"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/copperrails/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.assassinreport.copperrails.CopperRails"
		],
		"client": [
